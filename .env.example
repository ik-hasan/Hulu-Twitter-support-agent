# Copy to .env and fill in ONE of these if you want the optional LLM path.
# Nothing here is required to reproduce the headline numbers in reports/REPORT.md.

LLM_PROVIDER=gemini

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides
# LLM_MODEL=gemini-2.0-flash
